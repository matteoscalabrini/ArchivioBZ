{
  "name": "studio1-research-library",
  "version": "0.0.0",
  "private": true,
  "description": "The Studio 1 research library: one row per item held. Local with npm run serve, online at archiviobz.vercel.app with npm run deploy.",
  "type": "module",
  "scripts": {
    "build": "node library/build.mjs",
    "check": "npm run build -- --check",
    "check:edit": "node library/test/browser/edit.check.mjs",
    "db:sync": "node --env-file-if-exists=library/.deploy/.env.local library/db/sync.mjs",
    "deploy": "node library/deploy.mjs",
    "dev": "node library/tools/dev.mjs",
    "find:check": "node library/tools/find/accept.mjs",
    "map-data": "node library/mapgen/focus.mjs && uv run library/mapgen/fetch.py && uv run library/mapgen/build.py",
    "move-in": "node --env-file-if-exists=library/.deploy/.env.local library/tools/move-in.mjs",
    "password": "node library/tools/password.mjs",
    "present": "node library/build.mjs --present",
    "serve": "node library/serve.mjs",
    "test": "node --test 'library/test/*.test.mjs'"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@vercel/functions": "^3.11.3",
    "marked": "^18.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@vercel/blob": "^2.9.0",
    "mammoth": "^1.13.0",
    "puppeteer-core": "^25.18.1"
  }
}
